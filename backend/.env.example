NODE_ENV=development
PORT=6002

# Comma-separated list of allowed origins (the Vite dev frontend runs on 5002)
CORS_ORIGINS=http://localhost:5002

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcu_alumni
DB_USER=root
DB_PASSWORD=
# none | safe (create missing tables) | alter (update tables to match models - dev only)
DB_SYNC=safe
DB_LOGGING=false

# JWT - use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# First Super Admin created by `npm run seed`: their MCU Microsoft 365 email. They sign in with Microsoft.
SEED_ADMIN_EMAIL=admin@mcu.edu.ph
SEED_ADMIN_FULLNAME=MCU Administrator

# ---- Sign-in -----------------------------------------------------------------
# React app URL (Microsoft sign-in redirects back here)
FRONTEND_URL=http://localhost:5002
# Optional: secret for signed cookies (defaults to a key derived from JWT_ACCESS_SECRET)
COOKIE_SECRET=

# ---- Microsoft 365 / Entra ID sign-in (see README "Microsoft 365 sign-in") ------
M365_ENABLED=false
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Must match a "Web" redirect URI in the app registration
M365_REDIRECT_URI=http://localhost:5002/api/v1/auth/m365/callback
# Comma-separated email domains allowed to sign in (empty = any account in the tenant)
M365_ALLOWED_DOMAINS=mcu.edu.ph
