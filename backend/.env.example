NODE_ENV=development
PORT=6002

# Comma-separated list of allowed origins (the Vite dev frontend runs on 5002)
CORS_ORIGINS=http://localhost:5002

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcu_alumni
DB_USER=root
DB_PASSWORD=
# none | safe (create missing tables) | alter (update tables to match models - dev only)
DB_SYNC=safe
DB_LOGGING=false

# JWT - use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5

# First Super Admin created by `npm run seed`: their MCU Microsoft 365 email. They sign in with Microsoft.
SEED_ADMIN_EMAIL=admin@mcu.edu.ph
SEED_ADMIN_FULLNAME=MCU Administrator

# ---- Sign-in -----------------------------------------------------------------
# React app URL (Microsoft sign-in redirects back here)
FRONTEND_URL=http://localhost:5002
# Optional: secret for signed cookies (defaults to a key derived from JWT_ACCESS_SECRET)
COOKIE_SECRET=

# ---- Microsoft 365 / Entra ID sign-in (see README "Microsoft 365 sign-in") ------
M365_ENABLED=false
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Must match a "Web" redirect URI in the app registration
M365_REDIRECT_URI=http://localhost:5002/api/v1/auth/m365/callback
# Comma-separated email domains allowed to sign in (empty = any account in the tenant)
M365_ALLOWED_DOMAINS=mcu.edu.ph

# ---- Outgoing email via Microsoft 365 (Microsoft Graph) ---------------------------
# Uses the M365_* app above. In Entra ID, add the Microsoft Graph APPLICATION permission
# "Mail.Send" and grant admin consent. Ask IT to limit the app to this one mailbox with an
# Exchange Online application access policy (otherwise Mail.Send can send as any mailbox).
# Leave MAIL_FROM empty to write emails to the server log instead (development).
MAIL_FROM=
MAIL_FROM_NAME=MCU Alumni Relations
# New "Leave us a message" messages are emailed here (comma-separated). Replying to the
# notification in Outlook answers the sender directly.
MESSAGE_NOTIFY_TO=alumni@mcu.edu.ph

# ---- Security check (self-hosted CAPTCHA) ---------------------------------------------
# A distorted 5-digit code on Register, Forgot password, Resend verification, "Leave us a
# message" and "Notify me". Built in: no outside service or keys. On by default; set to
# false only to switch it off (e.g. automated tests).
CAPTCHA_ENABLED=true
